# Alianza Public API v2
# Development https://api.d2.alianza.com | QA https://api.q2.alianza.com
# Beta        https://api.b2.alianza.com | Production https://api.alianza.com
ALIANZA_BASE_URL=https://api.b2.alianza.com

# Admin Portal / API user. Create a dedicated API-only user; the username is an email address.
ALIANZA_USERNAME=
ALIANZA_PASSWORD=

# Alternative to username/password: a token obtained from POST /v2/authorize.
# Tokens expire 8 hours after last use and are not refreshed when set this way.
ALIANZA_AUTH_TOKEN=

# Default partition. Leave empty to use the partition of the login. Set for sub-partitions.
ALIANZA_PARTITION_ID=

API_TIMEOUT_MS=20000

# Transport: stdio (default) or http
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3000
MCP_HTTP_PATH=/mcp

# If set, HTTP clients must send: Authorization: Bearer <token>
MCP_AUTH_TOKEN=

# Comma-separated Host header allowlist. Set when MCP_HTTP_HOST is not loopback.
MCP_ALLOWED_HOSTS=

# debug | info | warn | error
LOG_LEVEL=info
