{
  "name": "alianza-mcp",
  "version": "0.1.0",
  "description": "MCP server for the Alianza Experience (Crux) API: enable Post-Call and Virtual Agent experiences for accounts and phone numbers, and read users.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "alianza-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "dev:http": "MCP_TRANSPORT=http tsx src/index.ts",
    "start": "node dist/index.js",
    "fake-api": "tsx src/fake-api.ts",
    "smoke": "tsx scripts/smoke.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "login": "tsx src/index.ts login"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "~1.30.0",
    "express": "^5.2.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  }
}
