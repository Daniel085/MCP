# Most settings can live in ~/.config/alianza-mcp/config.json (written by `alianza-mcp setup`).
# Environment variables override the file. ALIANZA_CONFIG_FILE changes the file location.
ALIANZA_CONFIG_FILE=~/.config/alianza-mcp/config.json
# Local usage log (tool names and outcomes only). Set to "off" to disable.
ALIANZA_USAGE_LOG=~/.config/alianza-mcp/usage.jsonl

# Environment: sandbox (default) or production. Sets the API and auth base URLs.
ALIANZA_ENV=sandbox
# Override the derived base URLs if needed.
ALIANZA_API_BASE_URL=
ALIANZA_AUTH_BASE_URL=

# OAuth client from Alianza onboarding.
ALIANZA_CLIENT_ID=
ALIANZA_CLIENT_SECRET=

# Your Experience id (UUID). Used as the default for every tool.
ALIANZA_EXPERIENCE_ID=

# User-context credentials. Normally written by `alianza-mcp login`.
ALIANZA_TOKEN_FILE=~/.config/alianza-mcp/tokens.json
# Headless alternative: a refresh token obtained elsewhere.
ALIANZA_REFRESH_TOKEN=
# Quick-test alternative: a raw access token (expires; no refresh).
ALIANZA_ACCESS_TOKEN=

# Login command settings. The redirect URI must be registered with Alianza.
ALIANZA_REDIRECT_URI=http://127.0.0.1:8765/callback
ALIANZA_SCOPES=experience-connections:manage experience-assignments:manage users:manage offline_access

API_TIMEOUT_MS=15000

# Transport: stdio (default) or http
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3000
MCP_HTTP_PATH=/mcp
MCP_AUTH_TOKEN=
MCP_ALLOWED_HOSTS=

LOG_LEVEL=info
