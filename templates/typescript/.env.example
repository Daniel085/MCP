# Upstream API
API_BASE_URL=http://127.0.0.1:4010
API_KEY=
API_TIMEOUT_MS=15000

# Transport: stdio (default) or http
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3000
MCP_HTTP_PATH=/mcp

# If set, HTTP clients must send: Authorization: Bearer <token>
MCP_AUTH_TOKEN=

# Comma-separated Host header allowlist. Set when MCP_HTTP_HOST is not loopback.
MCP_ALLOWED_HOSTS=

# debug | info | warn | error
LOG_LEVEL=info
